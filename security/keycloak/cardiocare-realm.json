{
  "realm": "cardiocare",
  "displayName": "CardioCare-AIOps",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "cardiocare-api",
      "name": "CardioCare API",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8000/*", "http://*:8000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "admin",        "description": "System administrator" },
      { "name": "cardiologist", "description": "Senior clinical role — full access" },
      { "name": "doctor",       "description": "Clinical read + alerts" },
      { "name": "nurse",        "description": "Patient vitals read" },
      { "name": "analyst",      "description": "AIOps analytics read-only" }
    ]
  },
  "users": [
    {
      "username": "dr.raees",
      "email": "raees.malik89@gmail.com",
      "firstName": "Muhammad",
      "lastName": "Raees",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "CardioCare@2024", "temporary": true }],
      "realmRoles": ["cardiologist", "admin"]
    },
    {
      "username": "demo.nurse",
      "email": "nurse@cardiocare.demo",
      "firstName": "Demo",
      "lastName": "Nurse",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Demo@1234", "temporary": true }],
      "realmRoles": ["nurse"]
    }
  ]
}
