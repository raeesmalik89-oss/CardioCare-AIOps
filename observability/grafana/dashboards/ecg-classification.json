{
  "title": "CardioCare-AIOps — Live ECG Classification (XGBoost)",
  "uid": "cardiocare-ecg-xgb",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "ECG Beats Classified (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(cardiocare_xgboost_predictions_total)",
          "legendFormat": "beats"
        }
      ]
    },
    {
      "id": 2,
      "title": "Replay Accuracy — cumulative (vs MIT-BIH label)",
      "description": "Replay/streaming evaluation: live predictions vs the replayed MIT-BIH ground-truth label. Not production accuracy (labels are from a previously annotated dataset).",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 90 },
            { "color": "green", "value": 95 }
          ] }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * cardiocare_xgboost_replay_accuracy",
          "legendFormat": "replay accuracy %"
        }
      ],
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 3,
      "title": "Critical Alerts Fired",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cardiocare_alerts_total",
          "legendFormat": "critical alerts"
        }
      ],
      "options": { "colorMode": "background", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } }
    },
    {
      "id": 4,
      "title": "Anomalies Detected",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cardiocare_anomalies_total",
          "legendFormat": "anomalies"
        }
      ]
    },
    {
      "id": 5,
      "title": "Beat Classifications by Class (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (predicted_class) (rate(cardiocare_xgboost_predictions_total[1m]))",
          "legendFormat": "{{predicted_class}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Beat Class Distribution (totals)",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (predicted_class) (cardiocare_xgboost_predictions_total)",
          "legendFormat": "{{predicted_class}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Replay Accuracy over time — cumulative vs sliding window",
      "description": "Real-time replay/streaming evaluation against replayed MIT-BIH labels. Not production accuracy.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * cardiocare_xgboost_replay_accuracy",
          "legendFormat": "cumulative"
        },
        {
          "datasource": "Prometheus",
          "expr": "100 * cardiocare_xgboost_replay_accuracy_window",
          "legendFormat": "sliding window"
        }
      ]
    }
  ]
}
