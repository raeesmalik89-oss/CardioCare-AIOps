{
  "title": "CardioCare-AIOps Live Monitor",
  "uid": "cardiocare-main",
  "timezone": "browser",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Events Processed",
      "gridPos": {"x":0,"y":0,"w":6,"h":4},
      "targets": [{"expr":"cardiocare_events_processed_total","datasource":"Prometheus"}],
      "options": {"colorMode":"background","graphMode":"area"},
      "fieldConfig": {"defaults":{"color":{"mode":"fixed","fixedColor":"green"}}}
    },
    {
      "id": 2, "type": "stat", "title": "CRITICAL Anomalies",
      "gridPos": {"x":6,"y":0,"w":6,"h":4},
      "targets": [{"expr":"cardiocare_anomalies_detected_total{severity=\"CRITICAL\"}","datasource":"Prometheus"}],
      "options": {"colorMode":"background"},
      "fieldConfig": {"defaults":{"color":{"mode":"fixed","fixedColor":"red"}}}
    },
    {
      "id": 3, "type": "stat", "title": "WARNING Anomalies",
      "gridPos": {"x":12,"y":0,"w":6,"h":4},
      "targets": [{"expr":"cardiocare_anomalies_detected_total{severity=\"WARNING\"}","datasource":"Prometheus"}],
      "options": {"colorMode":"background"},
      "fieldConfig": {"defaults":{"color":{"mode":"fixed","fixedColor":"orange"}}}
    },
    {
      "id": 4, "type": "stat", "title": "Last Isolation Forest Retrain",
      "gridPos": {"x":18,"y":0,"w":6,"h":4},
      "targets": [{"expr":"cardiocare_model_last_retrain","datasource":"Prometheus"}],
      "options": {"colorMode":"background"},
      "fieldConfig": {"defaults":{"color":{"mode":"fixed","fixedColor":"blue"},"unit":"percent"}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Anomaly Detection Rate by Severity",
      "gridPos": {"x":0,"y":4,"w":24,"h":8},
      "targets": [
        {"expr":"rate(cardiocare_anomalies_detected_total[5m])","legendFormat":"{{severity}}","datasource":"Prometheus"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Events Processed Per Second",
      "gridPos": {"x":0,"y":12,"w":12,"h":8},
      "targets": [
        {"expr":"rate(cardiocare_events_processed_total[1m])","legendFormat":"Events/sec","datasource":"Prometheus"}
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Processing Latency (99th percentile)",
      "gridPos": {"x":12,"y":12,"w":12,"h":8},
      "targets": [
        {"expr":"histogram_quantile(0.99, cardiocare_processing_latency_seconds_bucket)","legendFormat":"p99 latency","datasource":"Prometheus"}
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s"
}
