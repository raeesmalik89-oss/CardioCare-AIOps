{
  "title": "Patient Timeline",
  "uid": "patient-timeline",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [{
      "name": "patient_id",
      "type": "query",
      "datasource": "Prometheus",
      "query": "label_values(cardiocare_heart_rate, patient_id)",
      "refresh": 2,
      "current": {}
    }]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Heart Rate — $patient_id",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bpm",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red", "value": 111}
          ]}
        }
      },
      "targets": [{"expr": "cardiocare_heart_rate{patient_id=\"$patient_id\"}", "legendFormat": "HR"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "SpO2 — $patient_id",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 80, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 96}
          ]}
        }
      },
      "targets": [{"expr": "cardiocare_spo2{patient_id=\"$patient_id\"}", "legendFormat": "SpO2"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "NEWS2 Score — $patient_id",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 5},
            {"color": "red", "value": 7}
          ]}
        }
      },
      "targets": [{"expr": "cardiocare_news2_score{patient_id=\"$patient_id\"}", "legendFormat": "NEWS2"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Systolic BP — $patient_id",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"unit": "mmHg"}},
      "targets": [{"expr": "cardiocare_systolic_bp{patient_id=\"$patient_id\"}", "legendFormat": "Systolic BP"}]
    },
    {
      "id": 5, "type": "logs", "title": "Alert Log — $patient_id",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "datasource": "Loki",
      "options": {"dedupStrategy": "none", "showTime": true, "sortOrder": "Descending"},
      "targets": [{"expr": "{container=~\".+\"} |= \"$patient_id\"", "legendFormat": ""}]
    }
  ]
}
