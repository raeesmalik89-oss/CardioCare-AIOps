# ── EC2 Configuration ──────────────────────────────────────────────────────────
EC2_PUBLIC_IP=YOUR_EC2_PUBLIC_IP_HERE

# ── Kafka / Producer ─────────────────────────────────────────────────────────
EMIT_INTERVAL_MS=1000
SIMULATE_ANOMALIES=true
# DATA_SOURCE=real replays real MIT-BIH ECG beats; "simulated" generates vitals only.
DATA_SOURCE=real
# Host dir holding mitbih_train.csv / mitbih_test.csv (mounted read-only into producer).
# On EC2 the CSVs live at /data; for a repo-local copy use ./data.
MITBIH_DATA_DIR=/data
EVENT_ENCRYPTION_KEY=REPLACE_WITH_URLSAFE_BASE64_ENCODED_32_BYTE_KEY

# ── AIOps Engine ───────────────────────────────────────────────────────────────
ANOMALY_THRESHOLD=-0.1
MODEL_RETRAIN_INTERVAL=300

# ── Security ───────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=CardioCare@2024
ALLOWED_ORIGINS=http://localhost:3000

# ── Observability ──────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CardioCare@2024

# ── Alerts (optional webhook) ──────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
