{
  "title": "CardioCare-AIOps — Real-Time Cardiac Monitoring",
  "uid": "cardiocare-main",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Events Per Second (Kafka Throughput)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(cardiocare_events_total[1m])",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Anomalies Detected",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cardiocare_anomalies_total",
          "legendFormat": "anomalies"
        }
      ],
      "options": { "colorMode": "background", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 5 }] } }
    },
    {
      "id": 3,
      "title": "Critical Alerts Fired",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cardiocare_alerts_total",
          "legendFormat": "critical alerts"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latest Anomaly Score",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cardiocare_model_score",
          "legendFormat": "score"
        }
      ],
      "options": { "minValue": -1, "maxValue": 1 }
    },
    {
      "id": 5,
      "title": "Heart Rate by Patient",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cardiocare_heart_rate",
          "legendFormat": "{{bed_number}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "SpO2 by Patient",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cardiocare_spo2",
          "legendFormat": "{{bed_number}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Systolic BP by Patient",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cardiocare_systolic_bp",
          "legendFormat": "{{bed_number}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "API Processing Latency (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, rate(cardiocare_processing_seconds_bucket[5m]))",
          "legendFormat": "p99 latency"
        }
      ]
    },
    {
      "id": 9,
      "title": "Container Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{container_name=~\"cardiocare.*\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
